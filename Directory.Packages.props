<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup Label="Roslyn scripting (memory model, §5)">
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.14.0" />
    <!-- Microsoft.CodeAnalysis.CSharp (the plain compiler, not the Scripting layer above) is
         also referenced directly by Vouchfx.Engine.Orchestration.Tests: HeadlessTopologySelfHealTests
         compiles tiny synthetic host assemblies at test time (a fake AssemblyMetadata("DcpCliPath", …)
         carrier) to pin the DCP-path self-heal GLUE without touching Docker/DCP. Same version as the
         Scripting package above — they ship in lockstep from the same Roslyn release. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
  </ItemGroup>
  <ItemGroup Label="Aspire orchestration (§4) — net8.0 compatible">
    <PackageVersion Include="Aspire.Hosting" Version="13.4.2" />
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.4.2" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.4.2" />
    <PackageVersion Include="Aspire.Hosting.Kafka" Version="13.4.2" />
    <PackageVersion Include="Aspire.Hosting.Testing" Version="13.4.2" />
    <PackageVersion Include="Aspire.Hosting.SqlServer" Version="13.4.2" />
    <PackageVersion Include="Aspire.Hosting.MySql" Version="13.4.2" />
    <PackageVersion Include="Aspire.Hosting.MongoDB" Version="13.4.2" />
    <PackageVersion Include="Aspire.Hosting.Redis" Version="13.4.2" />
    <!-- Pinned to 13.3.0 — no 13.4.2 build is published on NuGet for this integration.
         Same major (13), API-identical surface (AddElasticsearch / WithImageTag); bump to
         13.4.x when a matching build is published. -->
    <PackageVersion Include="Aspire.Hosting.Elasticsearch" Version="13.3.0" />
    <PackageVersion Include="Aspire.Hosting.RabbitMQ" Version="13.4.2" />
    <PackageVersion Include="Aspire.Hosting.Nats" Version="13.4.2" />
  </ItemGroup>
  <ItemGroup Label="Resilience (§5.7) — Polly v8">
    <PackageVersion Include="Polly.Core" Version="8.6.6" />
  </ItemGroup>
  <ItemGroup Label="Transitive security pins (Dependabot alerts) — CentralPackageTransitivePinningEnabled">
    <!-- Pulled in via Aspire.Hosting -> StreamJsonRpc 2.22.23 (>= 2.5.192); pinned to the
         advisory-fixed 2.5.x build. -->
    <PackageVersion Include="MessagePack" Version="2.5.301" />
    <!-- Aspire.Hosting.MongoDB 13.4.2 transitively requires >= 1.0.0; pin to the exact
         required minimum to avoid NU1109 downgrade errors under
         CentralPackageTransitivePinningEnabled. 1.0.0 also covers the Dependabot
         advisory (fixed in 0.48.0), which is why Dependabot's own 0.48.0 pin in #213
         could not restore. -->
    <PackageVersion Include="SharpCompress" Version="1.0.0" />
    <!-- Azure.Messaging.ServiceBus 7.18.2 (via System.Memory.Data) floors System.Text.Json
         at a 6.0.x build vulnerable to CVE-2024-43485 (GHSA-8g4q-xg66-9fp4, .NET DoS;
         Dependabot alerts #31/#32/#56/#57 on the two azureservicebus providers and their
         tests — the only projects with no Aspire reference to lift them). Pinned to
         10.0.8, the exact floor Aspire.Hosting.* 13.4.2 already imposes everywhere else,
         to avoid NU1109 downgrade errors under CentralPackageTransitivePinningEnabled
         (the CVE fix landed in 8.0.5; 10.0.8 targets net8.0). -->
    <PackageVersion Include="System.Text.Json" Version="10.0.8" />
  </ItemGroup>
  <ItemGroup Label="CLI runner (S07-C-01) — System.CommandLine GA 2.0.x">
    <!-- Pinned to the 2.0.0 GA line: Argument&lt;T&gt;(name)-only ctor + init Description /
         DefaultValueFactory properties; Command(name, description); SetAction(Func&lt;ParseResult,
         CancellationToken, Task&lt;int&gt;&gt;); rootCommand.Parse(args).InvokeAsync(ct). The pre-GA
         betas exposed different ctor overloads (e.g. Argument&lt;T&gt;(name, () =&gt; default, desc)),
         so the version is pinned to keep the API surface this CLI compiles against stable. -->
    <PackageVersion Include="System.CommandLine" Version="2.0.0" />
  </ItemGroup>
  <ItemGroup Label="JSON / Schema / YAML (§5.7)">
    <PackageVersion Include="JsonPath.Net" Version="3.0.2" />
    <PackageVersion Include="JsonSchema.Net" Version="9.2.1" />
    <PackageVersion Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>
  <ItemGroup Label="Azure Service Bus emulator (mq-publish/expect.azureservicebus)">
    <!-- Azure.Messaging.ServiceBus 7.18.x: ServiceBusClient, ServiceBusSender,
         ServiceBusReceiver (PeekMessagesAsync), ServiceBusAdministrationClient.
         Pin to a stable 7.18 build; advance at engine cadence, not Azure SDK cadence.
         Both mq-publish.azureservicebus and mq-expect.azureservicebus reference this. -->
    <PackageVersion Include="Azure.Messaging.ServiceBus" Version="7.18.2" />
  </ItemGroup>
  <ItemGroup Label="Canonical clients (§5.7) — net8-era stable lines">
    <PackageVersion Include="Npgsql" Version="8.0.7" />
    <!-- Aspire.Hosting.SqlServer 13.4.2 transitively requires >= 7.0.1; pin to the
         exact required minimum to avoid NU1109/NU1605 downgrade errors under
         CentralPackageTransitivePinningEnabled. -->
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.0.1" />
    <PackageVersion Include="MySqlConnector" Version="2.4.0" />
    <PackageVersion Include="Confluent.Kafka" Version="2.14.2" />
    <PackageVersion Include="MongoDB.Driver" Version="3.8.1" />
    <PackageVersion Include="StackExchange.Redis" Version="2.13.1" />
    <!-- Aspire.Hosting.RabbitMQ 13.4.2 transitively requires >= 7.2.1; pin to the
         exact required minimum to avoid NU1109/NU1605 downgrade errors under
         CentralPackageTransitivePinningEnabled. -->
    <PackageVersion Include="RabbitMQ.Client" Version="7.2.1" />
    <!-- Aspire.Hosting.Nats 13.4.2 transitively requires >= 2.7.3; pin to the
         exact required minimum to avoid NU1109 downgrade errors under
         CentralPackageTransitivePinningEnabled. The mq-publish.nats and
         mq-expect.nats providers were authored against this API surface. -->
    <PackageVersion Include="NATS.Net" Version="2.7.3" />
  </ItemGroup>
  <ItemGroup Label="AWS SDK (db-assert.dynamodb / storage-assert.s3) — pinned to the latest 3.7.x line">
    <!-- AWS SDK v4 (4.0.x) is a recent major rewrite with breaking API changes; the 3.7.x
         line is the mature, stable series every existing worked example and StackOverflow
         answer targets, and it fully supports net8.0. Pin to the latest 3.7.x build of each
         package rather than v4 to avoid absorbing an unreviewed major-version migration here. -->
    <PackageVersion Include="AWSSDK.DynamoDBv2" Version="3.7.513.4" />
    <PackageVersion Include="AWSSDK.S3" Version="3.7.511.8" />
  </ItemGroup>
  <ItemGroup Label="Avro / schema-registry (S06) — ship in lockstep with Confluent.Kafka 2.14.2">
    <!-- Confluent.SchemaRegistry + Serdes.Avro version-match Confluent.Kafka (2.14.2).
         Apache.Avro is pinned to exactly the version Serdes.Avro 2.14.2 transitively
         requires, to avoid an NU1605 downgrade warning under TreatWarningsAsErrors. -->
    <PackageVersion Include="Confluent.SchemaRegistry" Version="2.14.2" />
    <PackageVersion Include="Confluent.SchemaRegistry.Serdes.Avro" Version="2.14.2" />
    <PackageVersion Include="Apache.Avro" Version="1.12.1" />
  </ItemGroup>
  <ItemGroup Label="Per-scenario isolation (S04-A-01)">
    <!-- Respawn 6.x: Respawner.CreateAsync(DbConnection, RespawnerOptions { DbAdapter = DbAdapter.Postgres })
         then respawner.ResetAsync(connection).  Npgsql adapter is included in Respawn 6.2.1. -->
    <PackageVersion Include="Respawn" Version="6.2.1" />
  </ItemGroup>
  <ItemGroup Label="SourceLink (S08-F-03) — symbols/source-stepping for the packed Vouchfx.Sdk">
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup Label="Test stack">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>
</Project>
