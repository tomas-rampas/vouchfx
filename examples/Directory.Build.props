<Project>
  <!-- Import the repo-root Directory.Build.props so every shared property
       (TargetFramework net8.0, LangVersion 11, Nullable, ImplicitUsings,
       TreatWarningsAsErrors, EnforceCodeStyleInBuild, AnalysisLevel) applies
       to the worked-example projects exactly as it does to the engine and the
       Core providers.  An external contributor copying examples/ gets the same
       quality bar the in-tree providers are held to. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!-- The worked example is a teaching template, not a shipped NuGet package. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>
