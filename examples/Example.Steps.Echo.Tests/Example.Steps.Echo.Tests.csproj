<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- The worked-example provider under test. -->
    <ProjectReference Include="..\Example.Steps.Echo\Example.Steps.Echo.csproj" />

    <!-- The out-of-repo provider test harness (Platform.Sdk.Testing).  A contributor
         pins this as a PackageReference to Platform.Sdk.Testing 1.0.0; in-tree we use a
         ProjectReference so the example builds against the current SDK.  This harness is
         the ONLY engine surface the test project needs: it transitively pulls the three
         packable engine assemblies (Abstractions / Authoring / Compilation) it uses to
         schema-validate, compile-once and run-isolated a single step WITHOUT Docker.  The
         test project deliberately does NOT reference any Platform.Engine.* project
         directly — it drives the provider purely through ProviderTestHarness. -->
    <ProjectReference Include="..\..\src\Sdk\Platform.Sdk.Testing\Platform.Sdk.Testing.csproj" />
  </ItemGroup>

</Project>
