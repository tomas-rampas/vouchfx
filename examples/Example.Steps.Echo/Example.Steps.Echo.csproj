<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- CRITICAL teaching point (§5.6 assembly-graph hygiene):
         a non-Core / customer provider MUST live in a NON-reserved namespace.
         'Vouchfx.Steps.*' and 'Vouchfx.Engine.*' are RESERVED for the engine and
         its Core providers — a customer DLL declaring those is refused at startup.
         This worked example uses 'Example.Steps.Echo' to model the rule correctly. -->
    <RootNamespace>Example.Steps.Echo</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- CLEAN-ROOM CONSTRAINT (§13): a worked-example / non-Core provider depends
         ONLY on the frozen v1 SDK contract (Vouchfx.Sdk).  It takes NO reference to any
         Vouchfx.Engine.* assembly: the engine drives the provider through the
         Vouchfx.Sdk interfaces, and the emitted CsxFragment reaches the run environment
         solely through the engine-injected `Vars` global (cross-step state passes only via
         Vars).  Engine types (Verdict, StepOutcome, VarKeys) appear in the emitted CSX by
         FULLY-QUALIFIED name only — the engine already references Vouchfx.Engine.Abstractions
         when it compiles the assembled script, so this provider never needs to.
         A PROJECT reference here keeps the example building in-tree against the current SDK;
         a contributor outside the repo would use a PackageReference to the published
         Vouchfx.Sdk package instead. -->
    <ProjectReference Include="..\..\src\Sdk\Vouchfx.Sdk\Vouchfx.Sdk.csproj" />
  </ItemGroup>

</Project>
