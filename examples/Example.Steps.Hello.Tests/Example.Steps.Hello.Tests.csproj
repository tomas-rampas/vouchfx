           • Platform.Engine.Abstractions — Verdict, StepOutcome, VarKeys,
                                            ScriptGlobalVariables (read the result). -->
    <ProjectReference Include="..\..\src\Sdk\Platform.Sdk\Platform.Sdk.csproj" />
    <ProjectReference Include="..\..\src\Engine\Platform.Engine.Abstractions\Platform.Engine.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Engine\Platform.Engine.Authoring\Platform.Engine.Authoring.csproj" />
