<Project Sdk="Microsoft.NET.Sdk">

  <!-- Aspire.AppHost.Sdk injects the DCP binary references and embeds the
       dcpclipath / aspiredashboardpath AssemblyMetadata attributes that
       DistributedApplication.CreateBuilder requires to locate the DCP process.
       This is the pre-approved R-1 fallback documented in CLAUDE.md §"Aspire (§4, §19)":
       a plain Aspire.Hosting library reference alone does NOT carry the DCP binaries,
       and StartAsync then throws OptionsValidationException ("CliPath ... is required").
       The CLI runner is the executable that HOSTS the engine, so it (not the engine
       library) must carry this SDK and pass its OWN assembly name ("vouchfx") to
       ScenarioRunner.RunSuiteAsync as appHostAssemblyName (see Program.cs). -->
  <Sdk Name="Aspire.AppHost.Sdk" Version="13.4.2" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>vouchfx</AssemblyName>
    <RootNamespace>Vouchfx.Cli</RootNamespace>
    <!-- Mark this project as an Aspire host so the AppHost build targets embed the
         DCP metadata onto THIS assembly (the one whose name we pass to the runner). -->
    <IsAspireHost>true</IsAspireHost>
  </PropertyGroup>

  <!-- dotnet tool packaging (S11-D-03).
       PackAsTool=true causes `dotnet pack` to produce a tool nupkg runnable via
       `dotnet tool install -g vouchfx`. The tool is framework-dependent (net8.0);
       DCP binaries are NOT bundled — they are resolved at runtime from the NuGet
       package cache via the dcpclipath AssemblyMetadata that the Aspire.AppHost.Sdk
       bakes in at build time. On the build machine this works out of the box (the
       NuGet cache path matches what was embedded). For cross-machine distribution
       the user must have the matching Aspire workload or NuGet packages installed so
       the DCP binaries are present; the embedded paths resolve into the standard
       per-user NuGet cache (~/.nuget/packages/aspire.hosting.orchestration.<RID>/).
       See docs/decisions/S11-D-03-dotnet-tool-packaging.md for the full analysis. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>vouchfx</ToolCommandName>
    <!-- The Aspire.AppHost.Sdk sets IsPublishable=false (aspire/issues/147) to suppress
         `dotnet publish` on AppHost projects. PackAsTool however depends on the Publish
         step to collect DLLs into tools/net8.0/any/. We explicitly re-enable IsPublishable
         here so that `dotnet pack` runs the publish pipeline and the tool nupkg contains
         all dependency DLLs — not just the DotnetToolSettings.xml skeleton. -->
    <IsPublishable>true</IsPublishable>
    <PackageId>vouchfx</PackageId>
    <Version>1.0.0</Version>
    <Authors>vouchfx</Authors>
    <Company>vouchfx</Company>
    <Description>vouchfx — compile and run declarative .e2e.yaml integration tests end-to-end against distributed .NET systems. Compiles YAML→C# (Roslyn), orchestrates the required container topology via .NET Aspire + Testcontainers, and executes steps covering REST, PostgreSQL, Kafka, webhooks, and custom scripting.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/tomas-rampas/vouchfx</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/tomas-rampas/vouchfx</PackageProjectUrl>
    <PackageTags>vouchfx;e2e;integration-testing;aspire;dotnet;testing</PackageTags>
    <!-- Deterministic, reproducible packaging. -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)'=='true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Expose the internal testable seams (ScenarioDiscovery, ExitCodes, RunCommand
       helpers) to the no-docker CLI test project. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Vouchfx.Cli.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <!-- AppHost must be a direct reference so its build targets run and embed the DCP
         metadata. Aspire.AppHost.Sdk auto-adds this package; the explicit reference
         pins the CPM version. -->
    <PackageReference Include="Aspire.Hosting.AppHost" />
  </ItemGroup>

  <ItemGroup>
    <!-- IsAspireProjectResource=false: these are libraries linked into the runner,
         not orchestrated services that Aspire should treat as project resources. -->
    <ProjectReference Include="..\..\Engine\Platform.Engine.Runtime\Platform.Engine.Runtime.csproj"
                      IsAspireProjectResource="false" />
    <!-- Opt-in, privacy-first telemetry (S10-G-04). A plain net8.0 library; no Aspire. -->
    <ProjectReference Include="..\..\Engine\Platform.Engine.Telemetry\Platform.Engine.Telemetry.csproj"
                      IsAspireProjectResource="false" />
    <ProjectReference Include="..\..\Providers\Core\Platform.Steps.Core.HttpRest\Platform.Steps.Core.HttpRest.csproj"
                      IsAspireProjectResource="false" />
    <ProjectReference Include="..\..\Providers\Core\Platform.Steps.DbAssert.Postgres\Platform.Steps.DbAssert.Postgres.csproj"
                      IsAspireProjectResource="false" />
    <ProjectReference Include="..\..\Providers\Core\Platform.Steps.Script.Csharp\Platform.Steps.Script.Csharp.csproj"
                      IsAspireProjectResource="false" />
    <ProjectReference Include="..\..\Providers\Core\Platform.Steps.MqPublish.Kafka\Platform.Steps.MqPublish.Kafka.csproj"
                      IsAspireProjectResource="false" />
    <ProjectReference Include="..\..\Providers\Core\Platform.Steps.MqExpect.Kafka\Platform.Steps.MqExpect.Kafka.csproj"
                      IsAspireProjectResource="false" />
    <ProjectReference Include="..\..\Providers\Core\Platform.Steps.WebhookListen.Http\Platform.Steps.WebhookListen.Http.csproj"
                      IsAspireProjectResource="false" />
    <ProjectReference Include="..\..\Providers\Core\Platform.Steps.DbAssert.SqlServer\Platform.Steps.DbAssert.SqlServer.csproj"
                      IsAspireProjectResource="false" />
    <ProjectReference Include="..\..\Providers\Core\Platform.Steps.DbAssert.Mongodb\Platform.Steps.DbAssert.Mongodb.csproj"
                      IsAspireProjectResource="false" />
    <ProjectReference Include="..\..\Providers\Core\Platform.Steps.DbAssert.Mysql\Platform.Steps.DbAssert.Mysql.csproj"
                      IsAspireProjectResource="false" />
    <ProjectReference Include="..\..\Providers\Core\Platform.Steps.MailExpect.Smtp\Platform.Steps.MailExpect.Smtp.csproj"
                      IsAspireProjectResource="false" />
    <ProjectReference Include="..\..\Providers\Core\Platform.Steps.CacheAssert.Redis\Platform.Steps.CacheAssert.Redis.csproj"
                      IsAspireProjectResource="false" />
    <ProjectReference Include="..\..\Providers\Core\Platform.Steps.CacheAssert.Elasticsearch\Platform.Steps.CacheAssert.Elasticsearch.csproj"
                      IsAspireProjectResource="false" />
    <ProjectReference Include="..\..\Providers\Core\Platform.Steps.MqPublish.Rabbitmq\Platform.Steps.MqPublish.Rabbitmq.csproj"
                      IsAspireProjectResource="false" />
    <ProjectReference Include="..\..\Providers\Core\Platform.Steps.MqExpect.Rabbitmq\Platform.Steps.MqExpect.Rabbitmq.csproj"
                      IsAspireProjectResource="false" />
    <ProjectReference Include="..\..\Providers\Core\Platform.Steps.MqPublish.Nats\Platform.Steps.MqPublish.Nats.csproj"
                      IsAspireProjectResource="false" />
    <ProjectReference Include="..\..\Providers\Core\Platform.Steps.MqExpect.Nats\Platform.Steps.MqExpect.Nats.csproj"
                      IsAspireProjectResource="false" />
  </ItemGroup>

  <ItemGroup Label="Provider client libs — direct refs so the DLLs deploy to output">
    <!-- The providers resolve these via Assembly.Location at runtime (and the Roslyn
         compile needs them on the reference path); a transitive project-reference path
         alone does not guarantee deployment to the output directory. Referenced
         directly here so the DLLs ship with the runner. Mirrors the Runtime test csproj. -->
    <PackageReference Include="Confluent.Kafka" />
    <PackageReference Include="Confluent.SchemaRegistry" />
    <PackageReference Include="Confluent.SchemaRegistry.Serdes.Avro" />
    <PackageReference Include="Apache.Avro" />
    <PackageReference Include="JsonPath.Net" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="MongoDB.Driver" />
    <PackageReference Include="MySqlConnector" />
    <PackageReference Include="StackExchange.Redis" />
    <PackageReference Include="RabbitMQ.Client" />
    <PackageReference Include="NATS.Net" />
  </ItemGroup>

</Project>
