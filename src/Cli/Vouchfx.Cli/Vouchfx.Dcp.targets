<Project>
  <!-- Headless Aspire host wiring, shared by EVERY project that uses Aspire.AppHost.Sdk: the
       CLI runner and the topology test hosts (Vouchfx.Engine.Orchestration.Tests,
       Vouchfx.Engine.Runtime.Tests). A new Aspire host must import this file too.

       The SDK's default references add Aspire.Hosting.AppHost plus TWO packages for the build
       host's RID: Aspire.Hosting.Orchestration.<rid> (DCP, which the engine needs) and
       Aspire.Dashboard.Sdk.<rid> (the dashboard, which the engine never starts: HeadlessTopology
       always sets DisableDashboard = true). Skipping the defaults and referencing DCP explicitly
       keeps the dashboard package out of the restore graph altogether, so its advisories
       (GHSA-4g86-54fm-h9h8, critical, every Aspire.Dashboard.Sdk.<rid> below 13.6.5; ZEB-33 holds Aspire at 13.4.x for v1.x)
       do not apply to any project here. That is removal of an unused dependency, not an audit
       suppression. Each host must therefore reference Aspire.Hosting.AppHost itself; the SDK
       reports ASPIRE002 when it is missing. -->
  <PropertyGroup>
    <SkipAddAspireDefaultReferences>true</SkipAddAspireDefaultReferences>
  </PropertyGroup>

  <!-- Explicit private references to DCP for the four advertised platforms. Their build
       assets are excluded so a foreign RID cannot overwrite the build host's DcpDir; DcpDir
       is set below instead. All four are restored so the CLI can bundle every RID (see
       Vouchfx.DcpBundle.targets); the test hosts share the same four packages, which keeps
       the solution's package set identical across hosts. -->
  <ItemGroup>
    <!-- VersionOverride keeps these ids out of Directory.Packages.props: a central
         PackageVersion would conflict with the SDK's own versioned implicit reference in any
         Aspire host that does not import this file. -->
    <PackageReference Include="Aspire.Hosting.Orchestration.win-x64" VersionOverride="$(VouchfxDcpVersion)" GeneratePathProperty="true" PrivateAssets="all" ExcludeAssets="all" />
    <PackageReference Include="Aspire.Hosting.Orchestration.linux-x64" VersionOverride="$(VouchfxDcpVersion)" GeneratePathProperty="true" PrivateAssets="all" ExcludeAssets="all" />
    <PackageReference Include="Aspire.Hosting.Orchestration.osx-x64" VersionOverride="$(VouchfxDcpVersion)" GeneratePathProperty="true" PrivateAssets="all" ExcludeAssets="all" />
    <PackageReference Include="Aspire.Hosting.Orchestration.osx-arm64" VersionOverride="$(VouchfxDcpVersion)" GeneratePathProperty="true" PrivateAssets="all" ExcludeAssets="all" />
  </ItemGroup>

  <!-- Set this during evaluation: Aspire's discovery target is conditionally skipped
       before BeforeTargets callbacks run when DcpDir is empty. Source builds and the test
       hosts embed the build host's package-cache path as dcpclipath; the published CLI
       prefers its portable bundle at run time. A build host whose SDK's portable RID is not
       one of these four (linux-arm64, win-arm64, linux-musl-x64) gets no dcpclipath, so
       topology start fails there with Aspire's "CliPath is required". -->
  <PropertyGroup>
    <!-- Distro-built SDKs report a non-portable RID (ubuntu.24.04-x64); match its portable form. -->
    <_VouchfxDcpHostRid>$(NETCoreSdkPortableRuntimeIdentifier)</_VouchfxDcpHostRid>
    <_VouchfxDcpHostRid Condition="'$(_VouchfxDcpHostRid)' == ''">$(NETCoreSdkRuntimeIdentifier)</_VouchfxDcpHostRid>
    <!-- Aspire 13.4.2 validates DashboardPath as non-empty even when disabled.
         HeadlessTopology always disables the dashboard; retain that metadata
         contract without restoring or distributing unused dashboard binaries. -->
    <AspireDashboardPath>disabled-by-vouchfx-headless-host</AspireDashboardPath>
    <DcpDir Condition="'$(_VouchfxDcpHostRid)' == 'win-x64'">$(PkgAspire_Hosting_Orchestration_win-x64)/tools/</DcpDir>
    <DcpDir Condition="'$(_VouchfxDcpHostRid)' == 'linux-x64'">$(PkgAspire_Hosting_Orchestration_linux-x64)/tools/</DcpDir>
    <DcpDir Condition="'$(_VouchfxDcpHostRid)' == 'osx-x64'">$(PkgAspire_Hosting_Orchestration_osx-x64)/tools/</DcpDir>
    <DcpDir Condition="'$(_VouchfxDcpHostRid)' == 'osx-arm64'">$(PkgAspire_Hosting_Orchestration_osx-arm64)/tools/</DcpDir>
  </PropertyGroup>
</Project>
