<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Platform.Engine.Compilation</RootNamespace>
  </PropertyGroup>

  <!-- Expose internal types (CollectibleScriptLoadContext) to the memory-model test project. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Platform.Engine.Compilation.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" />
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Platform.Engine.Abstractions\Platform.Engine.Abstractions.csproj" />
    <!--
      S02-C-02: the compiler consumes the provider contract (IStepBinder/IStepCompiler/…)
      and the StepKindRegistry to build the composed JSON Schema.  Platform.Sdk does NOT
      reference Platform.Engine.Compilation, so this edge is acyclic.
    -->
    <ProjectReference Include="..\..\Sdk\Platform.Sdk\Platform.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Schema\root-language-schema.json" />
  </ItemGroup>

</Project>
