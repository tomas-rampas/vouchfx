<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Platform.Engine.Orchestration</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <PackageReference Include="Aspire.Hosting.Kafka" />
    <!-- Respawn: per-scenario Postgres state reset (S04-A-01).
         Brings Npgsql adapter support; Npgsql itself resolves transitively. -->
    <PackageReference Include="Respawn" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Platform.Engine.Abstractions\Platform.Engine.Abstractions.csproj" />
    <!-- EnvironmentMapper consumes EnvironmentSpec / ServiceSpec / DependencySpec from Authoring.
         Authoring → Abstractions + Sdk + YamlDotNet; Orchestration → Authoring is acyclic. -->
    <ProjectReference Include="..\Platform.Engine.Authoring\Platform.Engine.Authoring.csproj" />
  </ItemGroup>

</Project>
