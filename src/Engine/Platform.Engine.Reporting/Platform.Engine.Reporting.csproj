<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Platform.Engine.Reporting</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Platform.Engine.Abstractions\Platform.Engine.Abstractions.csproj" />
  </ItemGroup>

  <!-- Expose the internal FileReportWriter seam (S09-D-01, T3) to the runtime (which both
       runner paths call after their terminal render) and to the reporting test project (which
       unit-tests the wiring directly, Docker-free). -->
  <ItemGroup>
    <InternalsVisibleTo Include="Platform.Engine.Runtime" />
    <InternalsVisibleTo Include="Platform.Engine.Reporting.Tests" />
    <!-- The runtime secret-redaction penetration suite (S11-B-01) drives the REAL
         FileReportWriter so its end-to-end events-artifact test asserts over the actual
         bytes on disk and cannot silently desync if the writer changes. -->
    <InternalsVisibleTo Include="Platform.Engine.Runtime.Tests" />
  </ItemGroup>

</Project>
