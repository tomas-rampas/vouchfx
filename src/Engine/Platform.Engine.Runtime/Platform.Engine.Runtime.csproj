<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Platform.Engine.Runtime</RootNamespace>
  </PropertyGroup>

  <!-- Expose internal types (ProviderPipeline, PipelineResult, …) to the Runtime test project. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Platform.Engine.Runtime.Tests</_Parameter1>
    </AssemblyAttribute>
    <!-- The CLI runner reuses ScenarioRunner.Elevate (verdict precedence) so the CLI and
         the engine can never disagree about how verdicts aggregate (S07-C-01). -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>vouchfx</_Parameter1>
    </AssemblyAttribute>
    <!-- The memory harness drives the internal ParallelSuiteRunner.RunParallelCoreAsync with a
         fake core to prove concurrent per-scenario collectible ALCs are all reclaimed (S08-T1). -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Platform.Engine.Compilation.MemoryHarness</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Platform.Engine.Abstractions\Platform.Engine.Abstractions.csproj" />
    <ProjectReference Include="..\Platform.Engine.Authoring\Platform.Engine.Authoring.csproj" />
    <ProjectReference Include="..\Platform.Engine.Compilation\Platform.Engine.Compilation.csproj" />
    <ProjectReference Include="..\Platform.Engine.Orchestration\Platform.Engine.Orchestration.csproj" />
    <ProjectReference Include="..\Platform.Engine.Reporting\Platform.Engine.Reporting.csproj" />
    <ProjectReference Include="..\..\Sdk\Platform.Sdk\Platform.Sdk.csproj" />
  </ItemGroup>

</Project>
