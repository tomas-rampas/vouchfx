<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Platform.Engine.Telemetry</RootNamespace>
  </PropertyGroup>

  <!-- Plain net8.0 library (no Aspire host, no Docker).  It references only the
       Abstractions leaf for the frozen event-payload records it READS from the
       buffered event stream to derive the privacy-allowlisted TelemetryEvent.  It
       NEVER references a frozen golden file, the schema, or any provider — it only
       consumes the existing v1 event stream.  System.Text.Json ships in-box with
       net8.0 (no PackageReference needed, §5.7). -->
  <ItemGroup>
    <ProjectReference Include="..\Platform.Engine.Abstractions\Platform.Engine.Abstractions.csproj" />
  </ItemGroup>

  <!-- Expose the internal seams (the consent-store internals, the event builder,
       the suppression predicate) to the Docker-free telemetry test project so the
       privacy guarantees can be proven directly. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Platform.Engine.Telemetry.Tests" />
  </ItemGroup>

</Project>
