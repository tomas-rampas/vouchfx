<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Vouchfx.Engine.Orchestration</RootNamespace>
  </PropertyGroup>

  <!-- Expose internal helpers (e.g. SeedApplier, S05-A-01) to the Orchestration
       test project so the no-docker tests can exercise them directly. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Vouchfx.Engine.Orchestration.Tests</_Parameter1>
    </AssemblyAttribute>
    <!-- Expose SeedFixtures.ComputeContentHash (S05-A-02) to the runner so the
         reproducibility envelope (S05-B-03) can record the SAME fixture content
         hash the seed applier computes, without duplicating the routine. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Vouchfx.Engine.Runtime</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Kestrel for the host-owned ephemeral webhook listener (S07-F-01a).
       WebhookListener binds Kestrel to http://0.0.0.0:0 so a containerised SUT can later
       reach it via host.docker.internal WITHOUT a Windows admin URL-ACL (which HttpListener
       on a non-loopback prefix would require).  Aspire transitively framework-references
       Microsoft.AspNetCore.App, but a class library does not carry the shared framework in
       its own output closure; declaring it explicitly here makes the Kestrel types resolve
       at compile time and documents the dependency, independent of Aspire's transitive graph.
       The host executables that consume this library (the CLI runner and the Aspire-host test
       projects, all <IsAspireHost>true</IsAspireHost>) carry the ASP.NET Core shared framework
       at runtime, so the types resolve when the listener actually runs. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <PackageReference Include="Aspire.Hosting.Kafka" />
    <PackageReference Include="Aspire.Hosting.SqlServer" />
    <PackageReference Include="Aspire.Hosting.MySql" />
    <PackageReference Include="Aspire.Hosting.MongoDB" />
    <PackageReference Include="Aspire.Hosting.Redis" />
    <PackageReference Include="Aspire.Hosting.Elasticsearch" />
    <PackageReference Include="Aspire.Hosting.RabbitMQ" />
    <PackageReference Include="Aspire.Hosting.Nats" />
    <!-- Respawn: per-scenario Postgres state reset (S04-A-01).
         Brings Npgsql adapter support. -->
    <PackageReference Include="Respawn" />
    <!-- Npgsql: explicit reference for SeedApplier (S05-A-01) — applies seed SQL
         against Postgres dependencies after the topology is healthy. Previously
         resolved transitively via Respawn; pinned directly so the dependency is
         not silently lost if Respawn's transitive graph changes. -->
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vouchfx.Engine.Abstractions\Vouchfx.Engine.Abstractions.csproj" />
    <!-- EnvironmentMapper consumes EnvironmentSpec / ServiceSpec / DependencySpec from Authoring.
         Authoring → Abstractions + Sdk + YamlDotNet; Orchestration → Authoring is acyclic. -->
    <ProjectReference Include="..\Vouchfx.Engine.Authoring\Vouchfx.Engine.Authoring.csproj" />
  </ItemGroup>

</Project>
