<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Vouchfx.Engine.Orchestration</RootNamespace>
  </PropertyGroup>

  <!-- Expose internal helpers (e.g. SeedApplier, S05-A-01) to the Orchestration
       test project so the no-docker tests can exercise them directly. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Vouchfx.Engine.Orchestration.Tests</_Parameter1>
    </AssemblyAttribute>
    <!-- Expose SeedFixtures.ComputeContentHash (S05-A-02) to the runner so the
         reproducibility envelope (S05-B-03) can content-hash fixtures without a
         duplicate hashing routine. NOT "the same hash the seed applier computes"
         (what this comment used to say, corrected under issue #484): SeedApplier
         reads and executes each SQL file and hashes nothing, and the envelope is
         this helper's only production caller. See SeedFixtures' own remarks. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Vouchfx.Engine.Runtime</_Parameter1>
    </AssemblyAttribute>
    <!-- authenticated-infrastructure-mtls, slice E (m3, peer-review fix round three): the drift
         guard pinning SecuredEndpointProbe's profile vocabulary to the security-profile REGISTRY
         needs to see internals of BOTH assemblies at once, and no test project could. The choice
         was between granting Vouchfx.Engine.Compilation's internals to
         Vouchfx.Engine.Orchestration.Tests — widening the deliberately narrow registry seam that
         project's own csproj comment warns about — and granting THIS assembly's internals to
         Vouchfx.Engine.Runtime.Tests, which already holds the registry grant. This is the second,
         and the smaller widening: Orchestration's internals are already visible to
         Vouchfx.Engine.Runtime, whose tests this is. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Vouchfx.Engine.Runtime.Tests</_Parameter1>
    </AssemblyAttribute>
    <!-- #473 lifted SecurityPathDisclosureLedger down from Vouchfx.Engine.Runtime into this
         assembly, because its new recording sites (ServerArtifactInjection, SeedApplier) live
         here and Runtime references Orchestration, not the other way round.

         THIS GRANT MOVED WITH THE TYPE; it is not a new licence. It was on the Runtime csproj,
         recorded there as scoped to this one use, and it is removed from that file by the same
         change. WatchRunnerSecurityLedgerTests seeds a ledger through the internal Record and
         reads the internal Count, to prove the watch loop's own sinks apply it (#375). Widening
         those members to public to avoid the grant would give away the opaque-token shape the
         type exists to keep.

         NO EQUIVALENT GRANT TO THE `vouchfx` CLI ASSEMBLY, deliberately, and that was a real
         choice rather than an omission. The CLI needs exactly ONE internal member - Scrub, at one
         call site - and granting it this assembly's internals would hand it SeedApplier,
         SeedFixtures, ServerArtifactInjection and the mapper's internals to reach that one
         method. It goes through Vouchfx.Engine.Runtime.SecurityPathScrub instead, which is a
         forwarder in an assembly the CLI is already trusted with; see that file's header.

         YES, THIS GRANT HANDS Vouchfx.Cli.Tests THE WHOLE INTERNAL SURFACE the paragraph above
         refuses to hand `vouchfx`, and that is not a contradiction — the two assemblies carry
         different risk. `vouchfx` is the SHIPPED CLI: an internal it can see is an internal a
         future change to production code can start depending on, quietly widening what the
         engine's layering permits. Vouchfx.Cli.Tests ships to nobody and its only consumer is
         this repository's own CI, so the cost of an over-broad grant there is a review question
         rather than a design one. The narrow-seam argument is spent where it buys something.

         SCOPED TO THAT ONE USE ANYWAY: this is not a general licence for Vouchfx.Cli.Tests to
         reach into orchestration internals. A new use needs its own justification recorded here,
         or it belongs in Vouchfx.Engine.Orchestration.Tests. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Vouchfx.Cli.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Kestrel for the host-owned ephemeral webhook listener (S07-F-01a).
       WebhookListener binds Kestrel to http://0.0.0.0:0 so a containerised SUT can later
       reach it via host.docker.internal WITHOUT a Windows admin URL-ACL (which HttpListener
       on a non-loopback prefix would require).  Aspire transitively framework-references
       Microsoft.AspNetCore.App, but a class library does not carry the shared framework in
       its own output closure; declaring it explicitly here makes the Kestrel types resolve
       at compile time and documents the dependency, independent of Aspire's transitive graph.
       The host executables that consume this library (the CLI runner and the Aspire-host test
       projects, all <IsAspireHost>true</IsAspireHost>) carry the ASP.NET Core shared framework
       at runtime, so the types resolve when the listener actually runs. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <PackageReference Include="Aspire.Hosting.Kafka" />
    <PackageReference Include="Aspire.Hosting.SqlServer" />
    <PackageReference Include="Aspire.Hosting.MySql" />
    <PackageReference Include="Aspire.Hosting.MongoDB" />
    <PackageReference Include="Aspire.Hosting.Redis" />
    <PackageReference Include="Aspire.Hosting.Elasticsearch" />
    <PackageReference Include="Aspire.Hosting.RabbitMQ" />
    <PackageReference Include="Aspire.Hosting.Nats" />
    <!-- Respawn: per-scenario relational state reset (S04-A-01, generalised to
         Postgres + SQL Server + MySQL). Brings the Npgsql/SqlServer/MySql adapters. -->
    <PackageReference Include="Respawn" />
    <!-- Npgsql: explicit reference for SeedApplier (S05-A-01) — applies seed SQL
         against Postgres dependencies after the topology is healthy. Previously
         resolved transitively via Respawn; pinned directly so the dependency is
         not silently lost if Respawn's transitive graph changes. -->
    <PackageReference Include="Npgsql" />
    <!-- Microsoft.Data.SqlClient: RespawnRelationalIsolation's SQL Server adapter
         (per-scenario state reset generalisation) opens a plain SqlConnection for
         Respawn to reset via DbAdapter.SqlServer. -->
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <!-- MySqlConnector: RespawnRelationalIsolation's MySQL adapter opens a plain
         MySqlConnection for Respawn to reset via DbAdapter.MySql. -->
    <PackageReference Include="MySqlConnector" />
    <!-- MongoDB.Driver: MongoScenarioIsolation deletes all documents from every
         non-system collection (DeleteManyAsync) between scenarios, preserving
         collections and their indexes. -->
    <PackageReference Include="MongoDB.Driver" />
    <!-- StackExchange.Redis: RedisScenarioIsolation issues FLUSHDB against the
         dependency's designated database between scenarios. -->
    <PackageReference Include="StackExchange.Redis" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vouchfx.Engine.Abstractions\Vouchfx.Engine.Abstractions.csproj" />
    <!-- EnvironmentMapper consumes EnvironmentSpec / ServiceSpec / DependencySpec from Authoring.
         Authoring → Abstractions + Sdk + YamlDotNet; Orchestration → Authoring is acyclic. -->
    <ProjectReference Include="..\Vouchfx.Engine.Authoring\Vouchfx.Engine.Authoring.csproj" />
  </ItemGroup>

</Project>
