<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Vouchfx.Engine.Planning</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Opts OUT of the repo-wide CS1591/CS1573 suppression (Directory.Build.targets):
         this project enforced both as build errors before that default existed, and its
         public surface is a published contract. See Directory.Build.props. -->
    <VouchfxDocumentEveryPublicMember>true</VouchfxDocumentEveryPublicMember>
  </PropertyGroup>

  <!-- NuGet packaging (M3 Planner / planner-coverage-and-gap-report): packable so
       REQ-001's "published/packable engine package" is satisfied literally. Mirrors the
       proven Vouchfx.Engine.Authoring packaging block verbatim.
       DECIDED DEVIATION (T1, per orchestrator instruction): this project is deliberately
       NOT added to release.yml's pack-and-publish loop this cycle — first-time creation of
       a new NuGet package ID under Trusted Publishing needs an owner nuget.org pre-flight
       (release.yml's own header warns of this). The project stays IsPackable=true and its
       public entry point is proven by an in-solution unit test (REQ-001's acceptance),
       satisfying the requirement without publishing yet. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>$(MSBuildProjectName)</PackageId>
    <!-- A bare `dotnet pack` (no -p:Version) yields 1.0.0-0.local: the numeric-leading prerelease identifier sorts below every published pre-release (alpha, beta, rc), so a local pack can never outrank anything on NuGet.org. -->
    <VersionPrefix>1.0.0</VersionPrefix>
    <VersionSuffix>0.local</VersionSuffix>
    <Authors>vouchfx</Authors>
    <Company>vouchfx</Company>
    <Description>vouchfx Planner — deterministic, read-only coverage-and-gap analysis over a declared suite folder, an event history, and the live step catalogue. Not yet part of the release pack loop; see the csproj header.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/tomas-rampas/vouchfx</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/tomas-rampas/vouchfx</PackageProjectUrl>
    <PackageTags>vouchfx;e2e;testing;engine;planner</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)'=='true'">true</ContinuousIntegrationBuild>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- Expose the internal ingest/analysis seams (SuiteSetLoader, EventHistoryReader,
       RunCorrelator, StepTargetResolver, PlanPipeline, the four analysers) to the test
       project only — the public surface stays limited to PlanExport / PlanRequest /
       PlanThresholds / PlanInputException / DependencyKindStepMap / StepFamilyRoles. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Vouchfx.Engine.Planning.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- StepNode.RawNode is a YamlMappingNode; StepTargetResolver reads the raw step body
         directly to resolve `target` without re-parsing YAML text. -->
    <PackageReference Include="YamlDotNet" />
    <!-- Build-only: emits SourceLink metadata into the PDB; not a runtime/lib dependency. -->
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vouchfx.Engine.Abstractions\Vouchfx.Engine.Abstractions.csproj" />
    <ProjectReference Include="..\Vouchfx.Engine.Authoring\Vouchfx.Engine.Authoring.csproj" />
    <ProjectReference Include="..\Vouchfx.Engine.Compilation\Vouchfx.Engine.Compilation.csproj" />
    <ProjectReference Include="..\..\Sdk\Vouchfx.Sdk\Vouchfx.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
