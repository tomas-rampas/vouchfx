<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Vouchfx.Engine.Runtime</RootNamespace>
  </PropertyGroup>

  <!-- Expose internal types (ProviderPipeline, PipelineResult, …) to the Runtime test project. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Vouchfx.Engine.Runtime.Tests</_Parameter1>
    </AssemblyAttribute>
    <!-- The CLI runner reuses ScenarioRunner.Elevate (verdict precedence) so the CLI and
         the engine can never disagree about how verdicts aggregate (S07-C-01). -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>vouchfx</_Parameter1>
    </AssemblyAttribute>
    <!-- The memory harness drives the internal ParallelSuiteRunner.RunParallelCoreAsync with a
         fake core to prove concurrent per-scenario collectible ALCs are all reclaimed (S08-T1). -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Vouchfx.Engine.Compilation.MemoryHarness</_Parameter1>
    </AssemblyAttribute>
    <!-- WatchRunnerSecurityLedgerTests seeds a SecurityPathDisclosureLedger to prove the watch
         loop's own terminal sinks apply it (issue #375). The TYPE is public (it appears on a
         public ScenarioRunner signature the CLI calls) but every MEMBER is internal, deliberately:
         it is an opaque token to anyone outside this assembly's friends. A behavioural test has to
         seed one, and widening Record/Scrub to public to avoid this grant would give away exactly
         the encapsulation that shape exists to keep.

         SCOPED TO THAT ONE USE: this grant exists solely for SecurityPathDisclosureLedger seeding.
         It is not a general licence for Vouchfx.Cli.Tests to reach into engine internals. A new
         use needs its own justification recorded here, or it belongs in
         Vouchfx.Engine.Runtime.Tests, which already owns engine-internal coverage. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Vouchfx.Cli.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vouchfx.Engine.Abstractions\Vouchfx.Engine.Abstractions.csproj" />
    <ProjectReference Include="..\Vouchfx.Engine.Authoring\Vouchfx.Engine.Authoring.csproj" />
    <ProjectReference Include="..\Vouchfx.Engine.Compilation\Vouchfx.Engine.Compilation.csproj" />
    <ProjectReference Include="..\Vouchfx.Engine.Orchestration\Vouchfx.Engine.Orchestration.csproj" />
    <ProjectReference Include="..\Vouchfx.Engine.Reporting\Vouchfx.Engine.Reporting.csproj" />
    <ProjectReference Include="..\..\Sdk\Vouchfx.Sdk\Vouchfx.Sdk.csproj" />
  </ItemGroup>

</Project>
