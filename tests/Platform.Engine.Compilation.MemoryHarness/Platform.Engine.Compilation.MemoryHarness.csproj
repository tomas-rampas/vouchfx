<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Platform.Engine.Compilation.MemoryHarness</RootNamespace>
    <!--
      Pin to Workstation GC so heap measurements are deterministic and not perturbed
      by Server GC's per-core heaps or Concurrent GC's background threads.
      Server GC (which CI hosts may enable by default) keeps heap segments alive longer,
      which can cause the net-delta assertion to report artificially large values even
      when no leak exists.  Workstation + non-concurrent GC gives the tightest baseline.
      This matches the GC settings already applied to the companion test project.
    -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Engine\Platform.Engine.Compilation\Platform.Engine.Compilation.csproj" />
    <!--
      Reference the HttpRest Core provider placeholder so that its transitive closure
      (and any future provider types it gains) is included in this harness's load
      context — the closure probe must exercise the full provider graph (§5).
    -->
    <ProjectReference Include="..\..\src\Providers\Core\Platform.Steps.Core.HttpRest\Platform.Steps.Core.HttpRest.csproj" />
  </ItemGroup>

  <ItemGroup Label="Canonical clients (§5.7) — closure probe forces their static initialisers">
    <!--
      These packages pull the full transitive closure of every Core provider's
      canonical client into the harness's Default context so the leak test exercises
      any singleton pinners (Npgsql pool, librdkafka handle, HttpClient handler pool).
      Versions are managed centrally in Directory.Packages.props.
    -->
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Confluent.Kafka" />
    <PackageReference Include="MongoDB.Driver" />
    <PackageReference Include="StackExchange.Redis" />
  </ItemGroup>

</Project>
