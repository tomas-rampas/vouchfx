<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Platform.Engine.Compilation.MemoryHarness</RootNamespace>
    <!--
      Pin to Workstation GC so heap measurements are deterministic and not perturbed
      by Server GC's per-core heaps or Concurrent GC's background threads.
      Server GC (which CI hosts may enable by default) keeps heap segments alive longer,
      which can cause the net-delta assertion to report artificially large values even
      when no leak exists.  Workstation + non-concurrent GC gives the tightest baseline.
      This matches the GC settings already applied to the companion test project.
    -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Engine\Platform.Engine.Compilation\Platform.Engine.Compilation.csproj" />
    <!--
      Reference the HttpRest Core provider placeholder so that its transitive closure
      (and any future provider types it gains) is included in this harness's load
      context — the closure probe must exercise the full provider graph (§5).
    -->
    <ProjectReference Include="..\..\src\Providers\Core\Platform.Steps.Core.HttpRest\Platform.Steps.Core.HttpRest.csproj" />
    <!--
      S08-T1: reference the Runtime engine so the concurrent-ALC-churn case can drive the
      internal ParallelSuiteRunner.RunParallelCoreAsync (via InternalsVisibleTo) with a fake
      core that loads + unloads a REAL collectible ALC per scenario.  The fake core never
      starts a topology, so this adds NO Aspire/Docker dependency to the harness run.
    -->
    <ProjectReference Include="..\..\src\Engine\Platform.Engine.Runtime\Platform.Engine.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup Label="Canonical clients (§5.7) — closure probe forces their static initialisers">
    <!--
      These packages pull the full transitive closure of every Core provider's
      canonical client into the harness's Default context so the leak test exercises
      any singleton pinners (Npgsql pool, librdkafka handle, HttpClient handler pool).
      Versions are managed centrally in Directory.Packages.props.
    -->
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Confluent.Kafka" />
    <PackageReference Include="MongoDB.Driver" />
    <PackageReference Include="StackExchange.Redis" />
    <!-- db-assert.sqlserver (Phase 1b) — Microsoft.Data.SqlClient transitive closure. -->
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <!-- db-assert.mysql — MySqlConnector transitive closure. -->
    <PackageReference Include="MySqlConnector" />
    <!-- mq-publish.rabbitmq / mq-expect.rabbitmq — RabbitMQ.Client transitive closure. -->
    <PackageReference Include="RabbitMQ.Client" />
    <!-- mq-publish.nats / mq-expect.nats — NATS.Net (Core + JetStream) transitive closure. -->
    <PackageReference Include="NATS.Net" />
    <!-- mq-publish.azureservicebus / mq-expect.azureservicebus — Azure Service Bus
         client (ServiceBusClient + ServiceBusAdministrationClient) transitive closure.
         The closure probe builds + DisposeAsync's a real ServiceBusClient every 50 iters. -->
    <PackageReference Include="Azure.Messaging.ServiceBus" />
    <!-- db-assert.dynamodb / storage-assert.s3 (Phase B) — AWSSDK.DynamoDBv2 / AWSSDK.S3
         transitive closure. The closure probe builds + Disposes a real AmazonDynamoDBClient
         and AmazonS3Client every 50 iters. -->
    <PackageReference Include="AWSSDK.DynamoDBv2" />
    <PackageReference Include="AWSSDK.S3" />
  </ItemGroup>

  <ItemGroup Label="Sprint-6 Kafka serdes (§5.7) — closure probe exercises the real Avro / schema-registry code paths">
    <!--
      The Sprint-6 mq-publish.kafka / mq-expect.kafka providers reference these three
      assemblies (Confluent.SchemaRegistry, its Avro serdes, and Apache.Avro).  The
      closure probe builds the same CachedSchemaRegistryClient + AvroSerializer/
      AvroDeserializer + GenericRecord those providers rely on, so the assemblies must
      be in this harness's output dir for typeof(...).Assembly.Location to resolve at
      compile time and for the runtime types to load into the Default ALC.  Versions are
      pinned centrally in Directory.Packages.props (lockstep with Confluent.Kafka 2.14.2).
      Polly.Core is NOT listed here: it arrives transitively via Platform.Engine.Abstractions
      (the probe drives RetryRunner, not Polly types directly) and is already in the output.
    -->
    <PackageReference Include="Confluent.SchemaRegistry" />
    <PackageReference Include="Confluent.SchemaRegistry.Serdes.Avro" />
    <PackageReference Include="Apache.Avro" />
  </ItemGroup>

</Project>
