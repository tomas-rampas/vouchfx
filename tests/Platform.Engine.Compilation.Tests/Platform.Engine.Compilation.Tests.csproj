<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Pin to Workstation GC so the collectibility / memory-leak gate tests are
      deterministic.  Server GC (which CI hosts may enable by default) has different
      unload timing that can cause the bounded GC-loop assertions to flake.
      This setting becomes a hard requirement once the memory-leak job is a blocking
      CI gate in Sprint 2.
    -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup Label="S08-F-01 — frozen v1 schema golden artifact">
    <!--
      The committed golden the SchemaFreezeTests gate diffs against.  Copied next
      to the test DLL so the test reads it from AppContext.BaseDirectory/Golden.
      Treated as a non-compiled Content item; CopyToOutputDirectory keeps it
      fresh on every build.
    -->
    <Content Include="Golden\composed-schema.v1.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!--
      Required by ForbiddenScriptingApiScannerTests: we compile a throwaway assembly
      in the negative-control test that calls Script<object>.RunAsync / EvaluateAsync,
      which requires this reference so the call binds at Roslyn compilation time.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" />
    <!-- S01-B-04 §5.7 canonical client libraries — spike: load/unload in collectible context. -->
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Confluent.Kafka" />
    <PackageReference Include="MongoDB.Driver" />
    <PackageReference Include="StackExchange.Redis" />
    <PackageReference Include="RabbitMQ.Client" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Engine\Platform.Engine.Compilation\Platform.Engine.Compilation.csproj" />
    <!--
      Reference the MemoryHarness exe project so this test project can use the public
      MemoryProbe type directly.  OutputType=Exe projects expose their public types to
      referencing projects normally; the test runner does not execute the exe, it calls
      MemoryProbe.RunAsync directly.
    -->
    <ProjectReference Include="..\Platform.Engine.Compilation.MemoryHarness\Platform.Engine.Compilation.MemoryHarness.csproj" />
    <!--
      S02-C-02: schema composition tests register HttpRestProvider from its assembly so
      the test can prove the constraint originates from the provider, not a central file.
    -->
    <ProjectReference Include="..\..\src\Providers\Core\Platform.Steps.Core.HttpRest\Platform.Steps.Core.HttpRest.csproj" />
    <!--
      S07-B-02b: the substitution-uniformity proof asserts the script.csharp boundary
      (its provider emits NO shared substitution helpers and splices author code verbatim),
      so the test references the script.csharp provider to read its Emit output directly.
    -->
    <ProjectReference Include="..\..\src\Providers\Core\Platform.Steps.Script.Csharp\Platform.Steps.Script.Csharp.csproj" />
    <!--
      S08-F-01 (T2 — freeze the v1 JSON Schema): SchemaFreezeTests builds the FULL
      six-Core-provider registry to compose the frozen v1 schema, so the test project
      must reference every Core provider assembly (mirroring the CLI's
      ProviderRegistryFactory).  HttpRest and Script.Csharp are already referenced
      above; the remaining four are added here.
    -->
    <ProjectReference Include="..\..\src\Providers\Core\Platform.Steps.DbAssert.Postgres\Platform.Steps.DbAssert.Postgres.csproj" />
    <ProjectReference Include="..\..\src\Providers\Core\Platform.Steps.DbAssert.SqlServer\Platform.Steps.DbAssert.SqlServer.csproj" />
    <ProjectReference Include="..\..\src\Providers\Core\Platform.Steps.DbAssert.Mongodb\Platform.Steps.DbAssert.Mongodb.csproj" />
    <ProjectReference Include="..\..\src\Providers\Core\Platform.Steps.DbAssert.Mysql\Platform.Steps.DbAssert.Mysql.csproj" />
    <ProjectReference Include="..\..\src\Providers\Core\Platform.Steps.MqPublish.Kafka\Platform.Steps.MqPublish.Kafka.csproj" />
    <ProjectReference Include="..\..\src\Providers\Core\Platform.Steps.MqExpect.Kafka\Platform.Steps.MqExpect.Kafka.csproj" />
    <ProjectReference Include="..\..\src\Providers\Core\Platform.Steps.WebhookListen.Http\Platform.Steps.WebhookListen.Http.csproj" />
    <ProjectReference Include="..\..\src\Providers\Core\Platform.Steps.MailExpect.Smtp\Platform.Steps.MailExpect.Smtp.csproj" />
    <ProjectReference Include="..\..\src\Providers\Core\Platform.Steps.CacheAssert.Redis\Platform.Steps.CacheAssert.Redis.csproj" />
    <ProjectReference Include="..\..\src\Providers\Core\Platform.Steps.CacheAssert.Elasticsearch\Platform.Steps.CacheAssert.Elasticsearch.csproj" />
    <ProjectReference Include="..\..\src\Providers\Core\Platform.Steps.MqPublish.Rabbitmq\Platform.Steps.MqPublish.Rabbitmq.csproj" />
    <ProjectReference Include="..\..\src\Providers\Core\Platform.Steps.MqExpect.Rabbitmq\Platform.Steps.MqExpect.Rabbitmq.csproj" />
    <ProjectReference Include="..\..\src\Providers\Core\Platform.Steps.MqPublish.Nats\Platform.Steps.MqPublish.Nats.csproj" />
    <ProjectReference Include="..\..\src\Providers\Core\Platform.Steps.MqExpect.Nats\Platform.Steps.MqExpect.Nats.csproj" />
    <ProjectReference Include="..\..\src\Providers\Core\Platform.Steps.MqPublish.AzureServiceBus\Platform.Steps.MqPublish.AzureServiceBus.csproj" />
    <ProjectReference Include="..\..\src\Providers\Core\Platform.Steps.MqExpect.AzureServiceBus\Platform.Steps.MqExpect.AzureServiceBus.csproj" />
    <!--
      Core batch A (18→21): mq-publish.redis + mq-expect.redis (Redis Streams) and the
      new metrics-assert.prometheus family — needed by SchemaFreezeTests,
      VsCodeShippedSchemaSyncTests, and ClosureProbeCoverageGuardTests, which build the
      FULL Core-provider registry.
    -->
    <ProjectReference Include="..\..\src\Providers\Core\Platform.Steps.MqPublish.Redis\Platform.Steps.MqPublish.Redis.csproj" />
    <ProjectReference Include="..\..\src\Providers\Core\Platform.Steps.MqExpect.Redis\Platform.Steps.MqExpect.Redis.csproj" />
    <ProjectReference Include="..\..\src\Providers\Core\Platform.Steps.MetricsAssert.Prometheus\Platform.Steps.MetricsAssert.Prometheus.csproj" />
  </ItemGroup>

</Project>
