<Project Sdk="Microsoft.NET.Sdk">
  <!-- Aspire.AppHost.Sdk injects DCP binary references (Aspire.Hosting.Orchestration.<RID>,
       where <RID> is resolved per build host: win-x64 on Windows, linux-x64 on the CI runner,
       osx-arm64 on Apple Silicon, etc.) and embeds the dcpclipath / dcpextensionpaths
       AssemblyMetadata attributes that DistributedApplication.CreateBuilder requires to
       locate the DCP process.
       This is the pre-approved R-1 fallback documented in CLAUDE.md §"Aspire (§4, §19)":
       a plain Aspire.Hosting library reference alone does NOT carry DCP binaries. -->
  <Sdk Name="Aspire.AppHost.Sdk" Version="13.4.2" />

  <!-- Mark this project as an Aspire host so the AppHost build targets embed the DCP metadata. -->
  <PropertyGroup>
    <IsAspireHost>true</IsAspireHost>
  </PropertyGroup>

  <ItemGroup>
    <!-- AppHost must be a *direct* reference so its build/ targets run and embed the DCP metadata.
         Aspire.AppHost.Sdk auto-adds this package; the explicit reference pins the CPM version. -->
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="Aspire.Hosting.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Npgsql: required by S01-A-03 connection-string acceptance test (live SELECT 1). -->
    <PackageReference Include="Npgsql" />
    <!-- Microsoft.Data.SqlClient: required by DbAssertSqlServerDockerTests (compile-ref). -->
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <!-- MongoDB.Driver: required by DbAssertMongodbDockerTests (compile-ref + seed). -->
    <PackageReference Include="MongoDB.Driver" />
  </ItemGroup>

  <ItemGroup>
    <!-- IsAspireProjectResource=false: these are libraries, not orchestrated services. -->
    <ProjectReference Include="..\..\src\Engine\Platform.Engine.Orchestration\Platform.Engine.Orchestration.csproj"
                      IsAspireProjectResource="false" />
    <ProjectReference Include="..\..\src\Engine\Platform.Engine.Compilation\Platform.Engine.Compilation.csproj"
                      IsAspireProjectResource="false" />
    <ProjectReference Include="..\..\src\Providers\Core\Platform.Steps.DbAssert.Postgres\Platform.Steps.DbAssert.Postgres.csproj"
                      IsAspireProjectResource="false" />
    <!-- script.csharp provider: used by RespawnResetProofTests (S04-A-01). -->
    <ProjectReference Include="..\..\src\Providers\Core\Platform.Steps.Script.Csharp\Platform.Steps.Script.Csharp.csproj"
                      IsAspireProjectResource="false" />
    <!-- db-assert.sqlserver provider: used by DbAssertSqlServerDockerTests. -->
    <ProjectReference Include="..\..\src\Providers\Core\Platform.Steps.DbAssert.SqlServer\Platform.Steps.DbAssert.SqlServer.csproj"
                      IsAspireProjectResource="false" />
    <!-- db-assert.mongodb provider: used by DbAssertMongodbDockerTests. -->
    <ProjectReference Include="..\..\src\Providers\Core\Platform.Steps.DbAssert.Mongodb\Platform.Steps.DbAssert.Mongodb.csproj"
                      IsAspireProjectResource="false" />
    <!-- Sprint 4 capstone: http.rest provider + ScenarioRunner (Runtime). -->
    <ProjectReference Include="..\..\src\Providers\Core\Platform.Steps.Core.HttpRest\Platform.Steps.Core.HttpRest.csproj"
                      IsAspireProjectResource="false" />
    <ProjectReference Include="..\..\src\Engine\Platform.Engine.Runtime\Platform.Engine.Runtime.csproj"
                      IsAspireProjectResource="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- JsonPath.Net must be a direct reference so its DLL is deployed to the output
         directory.  HttpRestProvider accesses it via Assembly.Location at runtime;
         the transitive project-reference path alone does not guarantee deployment. -->
    <PackageReference Include="JsonPath.Net" />
  </ItemGroup>

</Project>
