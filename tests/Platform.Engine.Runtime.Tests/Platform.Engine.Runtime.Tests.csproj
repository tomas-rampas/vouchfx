<Project Sdk="Microsoft.NET.Sdk">
  <!-- Aspire.AppHost.Sdk injects DCP binary references and embeds the
       dcpclipath / dcpextensionpaths AssemblyMetadata attributes that
       DistributedApplication.CreateBuilder requires to locate the DCP process.
       This is the pre-approved R-1 fallback documented in CLAUDE.md §"Aspire (§4, §19)":
       a plain Aspire.Hosting library reference alone does NOT carry DCP binaries. -->
  <Sdk Name="Aspire.AppHost.Sdk" Version="13.4.2" />

  <!-- Mark this project as an Aspire host so the AppHost build targets embed the DCP metadata. -->
  <PropertyGroup>
    <IsAspireHost>true</IsAspireHost>
  </PropertyGroup>

  <ItemGroup>
    <!-- AppHost must be a direct reference so its build targets run and embed the DCP metadata.
         Aspire.AppHost.Sdk auto-adds this package; the explicit reference pins the CPM version. -->
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- IsAspireProjectResource=false: these are libraries, not orchestrated services. -->
    <ProjectReference Include="..\..\src\Engine\Platform.Engine.Runtime\Platform.Engine.Runtime.csproj"
                      IsAspireProjectResource="false" />
    <ProjectReference Include="..\..\src\Providers\Core\Platform.Steps.Core.HttpRest\Platform.Steps.Core.HttpRest.csproj"
                      IsAspireProjectResource="false" />
    <!-- Sprint 4 capstone compile test: db-assert.postgres and script.csharp providers. -->
    <ProjectReference Include="..\..\src\Providers\Core\Platform.Steps.DbAssert.Postgres\Platform.Steps.DbAssert.Postgres.csproj"
                      IsAspireProjectResource="false" />
    <ProjectReference Include="..\..\src\Providers\Core\Platform.Steps.Script.Csharp\Platform.Steps.Script.Csharp.csproj"
                      IsAspireProjectResource="false" />
    <!-- Sprint 6 capstone (docker) + compile twin: the two Avro Kafka providers. -->
    <ProjectReference Include="..\..\src\Providers\Core\Platform.Steps.MqPublish.Kafka\Platform.Steps.MqPublish.Kafka.csproj"
                      IsAspireProjectResource="false" />
    <ProjectReference Include="..\..\src\Providers\Core\Platform.Steps.MqExpect.Kafka\Platform.Steps.MqExpect.Kafka.csproj"
                      IsAspireProjectResource="false" />
    <!-- Sprint 7 capstone (docker) + compile twin: the sixth Core provider. -->
    <ProjectReference Include="..\..\src\Providers\Core\Platform.Steps.WebhookListen.Http\Platform.Steps.WebhookListen.Http.csproj"
                      IsAspireProjectResource="false" />
    <!-- SUT env config (feature/sut-env-config) — ExamplesCompileTests needs every provider
         used across examples/**/*.e2e.yaml so the gate can compile ALL of them, not just the
         reference scenario's four technologies. -->
    <ProjectReference Include="..\..\src\Providers\Core\Platform.Steps.DbAssert.SqlServer\Platform.Steps.DbAssert.SqlServer.csproj"
                      IsAspireProjectResource="false" />
    <ProjectReference Include="..\..\src\Providers\Core\Platform.Steps.DbAssert.Mongodb\Platform.Steps.DbAssert.Mongodb.csproj"
                      IsAspireProjectResource="false" />
    <ProjectReference Include="..\..\src\Providers\Core\Platform.Steps.DbAssert.Mysql\Platform.Steps.DbAssert.Mysql.csproj"
                      IsAspireProjectResource="false" />
    <ProjectReference Include="..\..\src\Providers\Core\Platform.Steps.MailExpect.Smtp\Platform.Steps.MailExpect.Smtp.csproj"
                      IsAspireProjectResource="false" />
    <ProjectReference Include="..\..\src\Providers\Core\Platform.Steps.CacheAssert.Redis\Platform.Steps.CacheAssert.Redis.csproj"
                      IsAspireProjectResource="false" />
    <ProjectReference Include="..\..\src\Providers\Core\Platform.Steps.CacheAssert.Elasticsearch\Platform.Steps.CacheAssert.Elasticsearch.csproj"
                      IsAspireProjectResource="false" />
    <ProjectReference Include="..\..\src\Providers\Core\Platform.Steps.MqPublish.Rabbitmq\Platform.Steps.MqPublish.Rabbitmq.csproj"
                      IsAspireProjectResource="false" />
    <ProjectReference Include="..\..\src\Providers\Core\Platform.Steps.MqExpect.Rabbitmq\Platform.Steps.MqExpect.Rabbitmq.csproj"
                      IsAspireProjectResource="false" />
    <ProjectReference Include="..\..\src\Providers\Core\Platform.Steps.MqPublish.Nats\Platform.Steps.MqPublish.Nats.csproj"
                      IsAspireProjectResource="false" />
    <ProjectReference Include="..\..\src\Providers\Core\Platform.Steps.MqExpect.Nats\Platform.Steps.MqExpect.Nats.csproj"
                      IsAspireProjectResource="false" />
    <ProjectReference Include="..\..\src\Providers\Core\Platform.Steps.MqPublish.AzureServiceBus\Platform.Steps.MqPublish.AzureServiceBus.csproj"
                      IsAspireProjectResource="false" />
    <ProjectReference Include="..\..\src\Providers\Core\Platform.Steps.MqExpect.AzureServiceBus\Platform.Steps.MqExpect.AzureServiceBus.csproj"
                      IsAspireProjectResource="false" />
  </ItemGroup>

  <ItemGroup Label="Sprint 6 Kafka client libs — direct refs so the DLLs deploy to output">
    <!-- The Avro Kafka providers resolve these via Assembly.Location at runtime; the
         transitive project-reference path alone does not guarantee deployment to the
         output directory.  Confluent.Kafka may already be transitive — referenced
         directly here so its DLL (and the Avro/registry serde DLLs) ship with the tests. -->
    <PackageReference Include="Confluent.Kafka" />
    <PackageReference Include="Confluent.SchemaRegistry" />
    <PackageReference Include="Confluent.SchemaRegistry.Serdes.Avro" />
    <PackageReference Include="Apache.Avro" />
  </ItemGroup>

  <ItemGroup Label="ExamplesCompileTests provider client libs — direct refs so the DLLs deploy to output">
    <!-- Mirrors Platform.Engine.Orchestration.Tests.csproj: each provider below resolves its
         client library via Assembly.Location (ICompileReferenceContributor) at runtime; the
         transitive project-reference path alone does not guarantee deployment. -->
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="MongoDB.Driver" />
    <PackageReference Include="MySqlConnector" />
    <PackageReference Include="StackExchange.Redis" />
    <PackageReference Include="RabbitMQ.Client" />
    <PackageReference Include="NATS.Net" />
    <PackageReference Include="Azure.Messaging.ServiceBus" />
    <!-- JsonPath.Net must be a direct reference so its DLL is deployed to the output
         directory (HttpRestProvider accesses it via Assembly.Location at runtime). -->
    <PackageReference Include="JsonPath.Net" />
  </ItemGroup>

</Project>
