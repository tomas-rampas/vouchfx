<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Vouchfx.Cli.Tests</RootNamespace>
    <!-- This project tests CLI seams (discovery, registry, exit-code mapping, arg parsing)
         and explicitly Docker-gated Compose and managed Kafka acquisition. Aspire is hosted
         through Vouchfx.Cli's metadata, so this test assembly
         deliberately does NOT set IsAspireHost — Vouchfx.Cli exposes its internal helpers
         via InternalsVisibleTo for the normal command/watch acceptance paths.
         TargetFramework / IsPackable come from the root + tests Directory.Build.props. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!--
      Microsoft.CodeAnalysis.CSharp (the plain compiler, not the Scripting layer the engine uses):
      AsciiRuntimeOutputCensusTests parses the CLI and engine sources and asserts no literal token
      carries a non-ASCII character (#379). Roslyn rather than a regex because the distinction the
      gate needs — a LITERAL versus a COMMENT — is precisely the one a regex cannot draw reliably
      over verbatim strings, raw strings and a `//` inside a URL, and Roslyn draws it by putting
      comments and XML docs in trivia where no token walk can see them.

      Same central version the engine already pins, so this adds no new dependency to the graph and
      nothing to the shipped product: the reference is test-only and this project is not packable.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Cli\Vouchfx.Cli\Vouchfx.Cli.csproj" />
    <!--
      TestCertificateAuthority, for the one arm that needs REAL certificate material: the watch-mode
      topology starter must be reached with a RESOLVED security accessor rather than the null-object
      singleton, and a suite declaring `security` is refused at the artefact-existence gate unless
      the declared PEMs are on disk (#364, defect 1).

      Safe to add to this deliberately-lean project: Vouchfx.TestSupport carries NO ProjectReferences
      of its own (see its csproj), so this drags in no engine assembly and no Aspire, and nothing
      here becomes an Aspire host. The bed writes PEMs to a temp directory and installs nothing into
      any certificate store.
    -->
    <ProjectReference Include="..\Vouchfx.TestSupport\Vouchfx.TestSupport.csproj" />
    <!-- Build and copy a separate executable; never load its native clients in the test host. -->
    <ProjectReference Include="..\Vouchfx.Kafka.Security.Probe\Vouchfx.Kafka.Security.Probe.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Isolated console fixture; never changes the test host's console code page. -->
  <ItemGroup>
    <ProjectReference Include="..\Vouchfx.Cli.Encoding.Probe\Vouchfx.Cli.Encoding.Probe.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyEncodingProbe" AfterTargets="Build">
    <ItemGroup>
      <EncodingProbeFiles Include="..\Vouchfx.Cli.Encoding.Probe\bin\$(Configuration)\net8.0\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(EncodingProbeFiles)"
          DestinationFiles="@(EncodingProbeFiles->'$(OutDir)EncodingProbe\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

  <Target Name="CopyKafkaSecurityProbe" AfterTargets="Build">
    <ItemGroup>
      <KafkaSecurityProbeFiles Include="..\Vouchfx.Kafka.Security.Probe\bin\$(Configuration)\net8.0\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(KafkaSecurityProbeFiles)"
          DestinationFiles="@(KafkaSecurityProbeFiles->'$(OutDir)KafkaSecurityProbe\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

  <ItemGroup Label="#260 — frozen validate/list --json wire-shape golden artifacts">
    <!--
      The committed goldens ValidateJsonGoldenTests / ListJsonGoldenTests diff against.
      Copied next to the test DLL so the tests read them from AppContext.BaseDirectory/Golden.
    -->
    <Content Include="Golden\validate-json-document.v1.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Golden\list-json-document.v1.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\GoldenRegenerationPolicyTests.cs" Link="GoldenRegenerationPolicyTests.cs" />
  </ItemGroup>

</Project>
