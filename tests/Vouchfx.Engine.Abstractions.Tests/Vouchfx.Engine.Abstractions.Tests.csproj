<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <!-- Exercise the centrally resolved serializer the CLI deploys, not net8.0's inbox copy. -->
    <PackageReference Include="System.Text.Json" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Label="S08-F-02 — frozen v1 event-wire-contract golden artifact">
    <!--
      The committed golden the EventContractFreezeTests gate diffs against.  Copied
      next to the test DLL so the test reads it from AppContext.BaseDirectory/Golden.
      Treated as a non-compiled Content item; CopyToOutputDirectory keeps it fresh.
    -->
    <Content Include="Golden\vouchfx-engine-abstractions-public-api.v1.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Golden\event-stream-wire-contract.v1.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Golden\event-stream-wire-bytes.v1.jsonl">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Engine\Vouchfx.Engine.Abstractions\Vouchfx.Engine.Abstractions.csproj" />
    <!-- Build the real CLI so the runtime gate checks its resolved/deployed inputs.
         Its assembly is not a reference of this test host. -->
    <ProjectReference Include="..\..\src\Cli\Vouchfx.Cli\Vouchfx.Cli.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\GoldenRegenerationPolicyTests.cs" Link="GoldenRegenerationPolicyTests.cs" />
    <ProjectReference Include="..\Vouchfx.TestSupport\Vouchfx.TestSupport.csproj" />
  </ItemGroup>

  <Target Name="CopyEventContractCliRuntime" AfterTargets="Build">
    <PropertyGroup>
      <EventContractCliOutput>$(MSBuildProjectDirectory)\..\..\src\Cli\Vouchfx.Cli\bin\$(Configuration)\$(TargetFramework)</EventContractCliOutput>
    </PropertyGroup>
    <ItemGroup>
      <EventContractCliRuntime Include="$(EventContractCliOutput)\System.Text.Json.dll;$(EventContractCliOutput)\vouchfx.deps.json;$(EventContractCliOutput)\vouchfx.runtimeconfig.json" />
    </ItemGroup>
    <Copy SourceFiles="@(EventContractCliRuntime)" DestinationFolder="$(OutDir)EventContractCliRuntime" />
  </Target>

</Project>
