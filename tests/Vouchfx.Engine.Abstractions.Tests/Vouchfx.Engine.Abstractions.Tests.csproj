      The committed golden the EventContractFreezeTests gate diffs against.  Copied
      next to the test DLL so the test reads it from AppContext.BaseDirectory/Golden.
      Treated as a non-compiled Content item; CopyToOutputDirectory keeps it fresh.
    -->
    <Content Include="Golden\event-stream-wire-contract.v1.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

