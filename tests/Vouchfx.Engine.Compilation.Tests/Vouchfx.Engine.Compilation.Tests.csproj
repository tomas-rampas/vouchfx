<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Pin to Workstation GC so the collectibility / memory-leak gate tests are
      deterministic.  Server GC (which CI hosts may enable by default) has different
      unload timing that can cause the bounded GC-loop assertions to flake.
      This setting becomes a hard requirement once the memory-leak job is a blocking
      CI gate in Sprint 2.
    -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup Label="S08-F-01 — frozen v1 schema golden artifact">
    <!--
      The committed golden the SchemaFreezeTests gate diffs against.  Copied next
      to the test DLL so the test reads it from AppContext.BaseDirectory/Golden.
      Treated as a non-compiled Content item; CopyToOutputDirectory keeps it
      fresh on every build.
    -->
    <Content Include="Golden\composed-schema.v1.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup Label="Spec A — frozen catalogue wire-shape golden artifact">
    <Content Include="Golden\catalogue-document.v1.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup Label="Schema accepted/rejected corpus gate (SchemaAcceptedCorpusTests)">
    <!--
      The .e2e.yaml corpus documents SchemaAcceptedCorpusTests discovers and
      validates through DocumentValidator. Copied next to the test DLL (mirrors
      the Golden/ artifacts above) so the test reads them from
      AppContext.BaseDirectory/Corpus, rather than depending on the source
      tree's layout the way ExamplesCompileTests does for examples/ — these
      files live inside this test project, not at the repo root.
    -->
    <Content Include="Corpus\**\*.e2e.yaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!--
      Required by ForbiddenScriptingApiScannerTests: we compile a throwaway assembly
      in the negative-control test that calls Script<object>.RunAsync / EvaluateAsync,
      which requires this reference so the call binds at Roslyn compilation time.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" />
    <!-- S01-B-04 §5.7 canonical client libraries — spike: load/unload in collectible context. -->
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Confluent.Kafka" />
    <PackageReference Include="MongoDB.Driver" />
    <PackageReference Include="StackExchange.Redis" />
    <PackageReference Include="RabbitMQ.Client" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Engine\Vouchfx.Engine.Compilation\Vouchfx.Engine.Compilation.csproj" />
    <!--
      Reference the MemoryHarness exe project so this test project can use the public
      MemoryProbe type directly.  OutputType=Exe projects expose their public types to
      referencing projects normally; the test runner does not execute the exe, it calls
      MemoryProbe.RunAsync directly.
    -->
    <ProjectReference Include="..\Vouchfx.Engine.Compilation.MemoryHarness\Vouchfx.Engine.Compilation.MemoryHarness.csproj" />
    <!--
      S02-C-02: schema composition tests register HttpRestProvider from its assembly so
      the test can prove the constraint originates from the provider, not a central file.
    -->
    <ProjectReference Include="..\..\src\Providers\Core\Vouchfx.Steps.Core.HttpRest\Vouchfx.Steps.Core.HttpRest.csproj" />
    <!--
      S07-B-02b: the substitution-uniformity proof asserts the script.csharp boundary
      (its provider emits NO shared substitution helpers and splices author code verbatim),
      so the test references the script.csharp provider to read its Emit output directly.
    -->
    <ProjectReference Include="..\..\src\Providers\Core\Vouchfx.Steps.Script.Csharp\Vouchfx.Steps.Script.Csharp.csproj" />
    <!--
      S08-F-01 (T2 — freeze the v1 JSON Schema): SchemaFreezeTests builds the FULL
      six-Core-provider registry to compose the frozen v1 schema, so the test project
      must reference every Core provider assembly (mirroring the CLI's
      ProviderRegistryFactory).  HttpRest and Script.Csharp are already referenced
      above; the remaining four are added here.
    -->
    <ProjectReference Include="..\..\src\Providers\Core\Vouchfx.Steps.DbAssert.Postgres\Vouchfx.Steps.DbAssert.Postgres.csproj" />
    <ProjectReference Include="..\..\src\Providers\Core\Vouchfx.Steps.DbAssert.SqlServer\Vouchfx.Steps.DbAssert.SqlServer.csproj" />
    <ProjectReference Include="..\..\src\Providers\Core\Vouchfx.Steps.DbAssert.Mongodb\Vouchfx.Steps.DbAssert.Mongodb.csproj" />
    <ProjectReference Include="..\..\src\Providers\Core\Vouchfx.Steps.DbAssert.Mysql\Vouchfx.Steps.DbAssert.Mysql.csproj" />
    <ProjectReference Include="..\..\src\Providers\Core\Vouchfx.Steps.MqPublish.Kafka\Vouchfx.Steps.MqPublish.Kafka.csproj" />
    <ProjectReference Include="..\..\src\Providers\Core\Vouchfx.Steps.MqExpect.Kafka\Vouchfx.Steps.MqExpect.Kafka.csproj" />
    <ProjectReference Include="..\..\src\Providers\Core\Vouchfx.Steps.WebhookListen.Http\Vouchfx.Steps.WebhookListen.Http.csproj" />
    <ProjectReference Include="..\..\src\Providers\Core\Vouchfx.Steps.MailExpect.Smtp\Vouchfx.Steps.MailExpect.Smtp.csproj" />
    <ProjectReference Include="..\..\src\Providers\Core\Vouchfx.Steps.CacheAssert.Redis\Vouchfx.Steps.CacheAssert.Redis.csproj" />
    <ProjectReference Include="..\..\src\Providers\Core\Vouchfx.Steps.CacheAssert.Elasticsearch\Vouchfx.Steps.CacheAssert.Elasticsearch.csproj" />
    <ProjectReference Include="..\..\src\Providers\Core\Vouchfx.Steps.MqPublish.Rabbitmq\Vouchfx.Steps.MqPublish.Rabbitmq.csproj" />
    <ProjectReference Include="..\..\src\Providers\Core\Vouchfx.Steps.MqExpect.Rabbitmq\Vouchfx.Steps.MqExpect.Rabbitmq.csproj" />
    <ProjectReference Include="..\..\src\Providers\Core\Vouchfx.Steps.MqPublish.Nats\Vouchfx.Steps.MqPublish.Nats.csproj" />
    <ProjectReference Include="..\..\src\Providers\Core\Vouchfx.Steps.MqExpect.Nats\Vouchfx.Steps.MqExpect.Nats.csproj" />
    <ProjectReference Include="..\..\src\Providers\Core\Vouchfx.Steps.MqPublish.AzureServiceBus\Vouchfx.Steps.MqPublish.AzureServiceBus.csproj" />
    <ProjectReference Include="..\..\src\Providers\Core\Vouchfx.Steps.MqExpect.AzureServiceBus\Vouchfx.Steps.MqExpect.AzureServiceBus.csproj" />
    <!--
      Core batch A (18→21): mq-publish.redis + mq-expect.redis (Redis Streams) and the
      new metrics-assert.prometheus family — needed by SchemaFreezeTests,
      VsCodeShippedSchemaSyncTests, and ClosureProbeCoverageGuardTests, which build the
      FULL Core-provider registry.
    -->
    <ProjectReference Include="..\..\src\Providers\Core\Vouchfx.Steps.MqPublish.Redis\Vouchfx.Steps.MqPublish.Redis.csproj" />
    <ProjectReference Include="..\..\src\Providers\Core\Vouchfx.Steps.MqExpect.Redis\Vouchfx.Steps.MqExpect.Redis.csproj" />
    <ProjectReference Include="..\..\src\Providers\Core\Vouchfx.Steps.MetricsAssert.Prometheus\Vouchfx.Steps.MetricsAssert.Prometheus.csproj" />
    <!--
      Core batch B (21→23): db-assert.dynamodb and the new storage-assert.s3 family — needed
      by SchemaFreezeTests, VsCodeShippedSchemaSyncTests, LanguageReferenceGoldenTests, and
      ClosureProbeCoverageGuardTests, which build the FULL Core-provider registry.
    -->
    <ProjectReference Include="..\..\src\Providers\Core\Vouchfx.Steps.DbAssert.Dynamodb\Vouchfx.Steps.DbAssert.Dynamodb.csproj" />
    <ProjectReference Include="..\..\src\Providers\Core\Vouchfx.Steps.StorageAssert.S3\Vouchfx.Steps.StorageAssert.S3.csproj" />
    <!--
      Phase C (23→25): the new trace-expect family's Core provider (trace-expect.otlp) and the
      second http-family provider (http.soap) — needed by SchemaFreezeTests,
      VsCodeShippedSchemaSyncTests, LanguageReferenceGoldenTests, and
      ClosureProbeCoverageGuardTests, which build the FULL Core-provider registry.
    -->
    <ProjectReference Include="..\..\src\Providers\Core\Vouchfx.Steps.TraceExpect.Otlp\Vouchfx.Steps.TraceExpect.Otlp.csproj" />
    <ProjectReference Include="..\..\src\Providers\Core\Vouchfx.Steps.Http.Soap\Vouchfx.Steps.Http.Soap.csproj" />
  </ItemGroup>

</Project>
