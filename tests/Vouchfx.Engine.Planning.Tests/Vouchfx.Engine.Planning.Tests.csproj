<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Vouchfx.Engine.Planning.Tests</RootNamespace>
    <!-- Docker-free: the entire Planner is read-only over a suite folder + an event
         history file, so no [Trait("requires","docker")] appears anywhere in this project —
         which is what makes the REQ-014 loop-closure test satisfiable in the fast CI job. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Label="M3 Planner — frozen v1 report golden artifact">
    <Content Include="Golden\plan-report-document.v1.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Recursive glob: T2/T3/T4 drop fixture files into their own subfolders
       (Fixtures/coverage, Fixtures/vocabulary, Fixtures/history) with no csproj edit. -->
  <ItemGroup Label="Test fixtures">
    <Content Include="Fixtures\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Engine\Vouchfx.Engine.Planning\Vouchfx.Engine.Planning.csproj" />
  </ItemGroup>

  <!--
    REQ-005's drift test asserts every mapped step type exists in "the current
    registration", and the REQ-014 loop-closure test scaffolds against the real catalogue —
    both need the full 25-provider registry. Mirrors
    tests/Vouchfx.Engine.Compilation.Tests/Vouchfx.Engine.Compilation.Tests.csproj's provider
    ProjectReference list exactly; keep the two in step (ClosureProbeCoverageGuardTests keeps
    that project's own list honest, and tests/Vouchfx.Cli.Tests/PlanRegistrationParityTests.cs
    keeps this Planner registry honest against the shipped CLI's ProviderRegistryFactory).
  -->
  <ItemGroup Label="Core providers — full 25-provider registry (mirrors Vouchfx.Engine.Compilation.Tests.csproj)">
    <ProjectReference Include="..\..\src\Providers\Core\Vouchfx.Steps.Core.HttpRest\Vouchfx.Steps.Core.HttpRest.csproj" />
    <ProjectReference Include="..\..\src\Providers\Core\Vouchfx.Steps.Http.Soap\Vouchfx.Steps.Http.Soap.csproj" />
