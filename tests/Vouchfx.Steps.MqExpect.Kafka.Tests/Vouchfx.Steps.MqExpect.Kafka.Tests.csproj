<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- C# 12 for this project only. The net10.0 [GeneratedRegex] source generator emits a
         collection expression (SearchValues.Create(["..."], ...)) for a pattern with a
         literal search prefix whatever the project's LangVersion, so under the repo-wide
         C# 11 the generated file fails with CS9058. The repo-wide LangVersion stays 11. -->
    <LangVersion>12</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Confluent.Kafka" />
    <PackageReference Include="JsonPath.Net" />
    <!-- Avro serdes — needed so the emit compile-round-trip can supply the serdes
         metadata as compile-time references for the emitted Avro CSX. -->
    <PackageReference Include="Confluent.SchemaRegistry" />
    <PackageReference Include="Confluent.SchemaRegistry.Serdes.Avro" />
    <PackageReference Include="Apache.Avro" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Engine\Vouchfx.Engine.Abstractions\Vouchfx.Engine.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Engine\Vouchfx.Engine.Compilation\Vouchfx.Engine.Compilation.csproj" />
    <ProjectReference Include="..\..\src\Providers\Core\Vouchfx.Steps.MqExpect.Kafka\Vouchfx.Steps.MqExpect.Kafka.csproj" />
    <ProjectReference Include="..\..\src\Sdk\Vouchfx.Sdk\Vouchfx.Sdk.csproj" />
    <!-- The published provider-test harness, for its ICompileContext double
         (Vouchfx.Sdk.Testing.Contexts.TestCompileContext).  Referenced rather than
         hand-rolling a fifth local stub in this assembly; see
         MqExpectKafkaDrainWindowPinTests. -->
    <ProjectReference Include="..\..\src\Sdk\Vouchfx.Sdk.Testing\Vouchfx.Sdk.Testing.csproj" />
  </ItemGroup>

</Project>
