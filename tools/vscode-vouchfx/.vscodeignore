# Sources & build inputs — the compiled output lives in dist/
src/**/*.ts
src/test/**
dist/test/**
**/*.map
tsconfig.json
.eslintrc.json
.gitignore
.vscodeignore
scripts/**

# Dev-time / repo noise
.vscode/**
.github/**
node_modules/**
**/*.vsix

# RUNTIME DEPENDENCY — `yaml` (eemeli/yaml) MUST ship: there is no bundler
# (the build is plain `tsc`), so `dist/e2eYamlOutline.js` does `require('yaml')`
# from node_modules at runtime. `yaml` has ZERO runtime dependencies. Node
# resolves `main: ./dist/index.js`, so ONLY `dist/`, `package.json` and the
# `util.js` re-export shim are load-bearing — the `browser/` build is for
# bundlers and is deliberately NOT re-included (keeping the VSIX lean). We
# whitelist the exact load-bearing paths rather than the whole package so the
# browser build stays excluded regardless of `.vscodeignore` negation ordering.
!node_modules/yaml/dist/**
!node_modules/yaml/package.json
!node_modules/yaml/util.js

# Keep the bundled schema: the manifest yamlValidation.url resolves to
# ./src/schema/composed-schema.v1.json at runtime, so it MUST ship.
!src/schema/composed-schema.v1.json

# The TextMate injection grammar (syntaxes/) and the human-eyeball fixture
# (examples/) and the IntelliSense-status note (docs/) are NOT excluded above,
# so they ship in the .vsix. The grammar MUST ship — contributes.grammars[0].path
# resolves to ./syntaxes/csharp-in-e2eyaml.injection.json at runtime. This rule
# defends it explicitly in case the src/** exclusion above is ever broadened.
!syntaxes/**
