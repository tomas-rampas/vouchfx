# Sources & build inputs — the compiled output lives in dist/
src/**/*.ts
src/test/**
dist/test/**
**/*.map
tsconfig.json
.eslintrc.json
.gitignore
.vscodeignore
scripts/**

# Dev-time / repo noise
.vscode/**
.github/**
node_modules/**
**/*.vsix

# Keep the bundled schema: the manifest yamlValidation.url resolves to
# ./src/schema/composed-schema.v1.json at runtime, so it MUST ship.
!src/schema/composed-schema.v1.json

# The TextMate injection grammar (syntaxes/) and the human-eyeball fixture
# (examples/) and the IntelliSense-status note (docs/) are NOT excluded above,
# so they ship in the .vsix. The grammar MUST ship — contributes.grammars[0].path
# resolves to ./syntaxes/csharp-in-e2eyaml.injection.json at runtime. This rule
# defends it explicitly in case the src/** exclusion above is ever broadened.
!syntaxes/**
