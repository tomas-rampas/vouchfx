{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vouchfx.io/environment/compose/v1.json",
  "title": "Owned Compose Environment",
  "description": "Configuration for fresh, owned Docker Compose environments with explicit HTTP, TCP and PostgreSQL bindings. Manifests are interpreted by native Docker Compose, not by this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "files"],
  "anyOf": [
    { "required": ["services"], "properties": { "services": { "minProperties": 1 } } },
    { "required": ["dependencies"], "properties": { "dependencies": { "minProperties": 1 } } }
  ],
  "properties": {
    "version": { "const": 1 },
    "files": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
    "projectDirectory": { "$ref": "#/$defs/path" },
    "profiles": { "type": "array", "items": { "$ref": "#/$defs/name" } },
    "envFiles": { "type": "array", "items": { "$ref": "#/$defs/path" } },
    "environment": {
      "type": "object",
      "propertyNames": { "pattern": "^(?!COMPOSE_)(?!DOCKER_)[A-Za-z_][A-Za-z0-9_.]*(?![\\s\\S])" },
      "additionalProperties": { "$ref": "#/$defs/environmentValue" }
    },
    "startupTimeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 600, "default": 120 },
    "cleanupTimeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 120, "default": 30 },
    "services": {
      "type": "object", "propertyNames": { "$ref": "#/$defs/name" },
      "additionalProperties": { "oneOf": [{ "$ref": "#/$defs/httpBinding" }, { "$ref": "#/$defs/tcpBinding" }] }
    },
    "dependencies": {
      "type": "object", "propertyNames": { "$ref": "#/$defs/name" },
      "additionalProperties": {
        "type": "object", "additionalProperties": false, "required": ["type", "service", "port", "database", "username", "password"],
        "properties": {
          "type": { "const": "postgres" }, "service": { "$ref": "#/$defs/name" }, "port": { "$ref": "#/$defs/port" },
          "database": { "$ref": "#/$defs/scalarText" }, "username": { "$ref": "#/$defs/scalarText" },
          "password": { "$ref": "#/$defs/credential" }
        }
      }
    }
  },
  "$defs": {
    "httpBinding": {
      "type": "object", "additionalProperties": false, "required": ["service", "port", "readiness"],
      "properties": {
        "type": { "const": "http", "default": "http" },
        "service": { "$ref": "#/$defs/name" }, "port": { "$ref": "#/$defs/port" },
        "readiness": {
          "type": "object", "additionalProperties": false, "required": ["path"],
          "properties": {
            "type": { "const": "http" },
            "path": { "type": "string", "pattern": "^/(?!/)[^?#]*$", "not": { "pattern": "\\$\\{" } },
            "status": { "type": "integer", "minimum": 100, "maximum": 599, "default": 200 }
          }
        }
      }
    },
    "tcpBinding": {
      "type": "object", "additionalProperties": false, "required": ["type", "service", "port", "readiness"],
      "properties": {
        "type": { "const": "tcp" },
        "service": { "$ref": "#/$defs/name" }, "port": { "$ref": "#/$defs/port" },
        "readiness": {
          "type": "object", "additionalProperties": false, "required": ["type"],
          "properties": {
            "type": { "enum": ["tcp", "healthcheck"], "description": "tcp proves host endpoint reachability only; healthcheck also requires the explicitly configured native service healthcheck to be healthy." }
          }
        }
      }
    },
    "name": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$" },
    "path": { "type": "string", "minLength": 1, "not": { "pattern": "\\$\\{" } },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "scalarText": { "type": ["string", "number", "integer", "boolean"], "minLength": 1 },
    "credential": { "type": "string", "pattern": "^\\$\\{secret:env/[A-Za-z_][A-Za-z0-9_]*\\}$" },
    "environmentValue": {
      "anyOf": [
        { "$ref": "#/$defs/credential" },
        { "$ref": "#/$defs/scalarText", "not": { "type": "string", "pattern": "\\$\\{" } }
      ]
    }
  }
}
